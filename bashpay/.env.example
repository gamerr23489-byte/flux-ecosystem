# Public client
VITE_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_here
VITE_API_BASE_URL=

# Server-only
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/bashpay
DATABASE_SSL=true
CLERK_SECRET_KEY=sk_test_or_sk_live_here
CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live_here
APP_ORIGIN=https://bashpay.example.com

# Owner-only server secrets
