OWNER_ADMIN_PIN=
OWNER_ADMIN_KEY=
SKYLINK_INTERNAL_CLERK_USER_ID=

# Flutterwave
# Public key may be exposed to the browser when required; secret stays server-side.
FLW_ENV=sandbox
FLW_PUBLIC_KEY=FLWPUBK_TEST_your_key_here
FLW_SECRET_KEY=
# Flutterwave v4 OAuth credentials for current FX/cross-border APIs
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_SECRET_HASH=
LIVE_PAYMENTS_ENABLED=false
